{
  "version": 1,
  "timezone": "Asia/Shanghai",
  "rotation": "continuous-day-modulo-365",
  "count": 365,
  "quotes": [
    {
      "text": "忧先于事，故能无忧；事至而忧，无救于事。",
      "source": "《资治通鉴·唐纪·唐纪五十三》"
    },
    {
      "text": "思其人，至其乡；其处在，其人亡。",
      "source": "《资治通鉴·汉纪三十九》"
    },
    {
      "text": "以权利合者，权利尽而交疏",
      "source": "《史记·郑世家》"
    },
    {
      "text": "岂曰无衣？与子同袍。王于兴师，修我戈矛，与子同仇。",
      "source": "《诗经·秦风·无衣》"
    },
    {
      "text": "强人之所不能，事必不立；禁人之所必犯，法必不得矣。",
      "source": "《资治通鉴·唐纪·唐纪五十八》"
    },
    {
      "text": "天时不如地利，地利不如人和。",
      "source": "《孟子·公孙丑章句下·第一节》"
    },
    {
      "text": "婚姻者，居屋之大伦也。",
      "source": "《史记·七十列传·儒林列传》"
    },
    {
      "text": "血染征袍透甲红，当阳谁敢与争锋！古来冲阵扶危主，只有常山赵子龙。",
      "source": "《三国演义·第四十一回》"
    },
    {
      "text": "口说不如身逢，耳闻不如目睹。",
      "source": "《资治通鉴·唐纪·唐纪二十六》"
    },
    {
      "text": "仁者爱万物而智者备祸於未形，不仁不智，何以为国？",
      "source": "《史记·赵世家》"
    },
    {
      "text": "自古骄兵多致败，从来轻敌少成功。",
      "source": "《三国演义·第六十九回》"
    },
    {
      "text": "拼将一死酬知己，致令千秋仰义名。",
      "source": "《三国演义·第五十回》"
    },
    {
      "text": "克己复礼为仁。",
      "source": "《论语·颜渊》"
    },
    {
      "text": "春梦随云散，飞花逐水流，寄言众儿女，何必觅闲愁。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "宠辱不惊，肝木自宁",
      "source": "《资治通鉴·唐纪·唐纪十七》"
    },
    {
      "text": "少年读书，如隙中窥月；中年读书，如庭中望月；老年读书，如台上玩月。皆以阅历之浅深为所得之浅深耳。",
      "source": "《幽梦影》"
    },
    {
      "text": "无我原非你，从他不解伊。",
      "source": "《红楼梦·第二十二回》"
    },
    {
      "text": "景有言之极幽而实萧索者，烟雨也；境有言之极雅而实难堪者，贫病也；声有言之极韵而实粗鄙者，卖花声也。",
      "source": "《幽梦影》"
    },
    {
      "text": "君子有终身之忧，无一朝之患也。",
      "source": "《孟子·离娄章句下·第二十八节》"
    },
    {
      "text": "月出皎兮，佼人僚兮。舒窈纠兮，劳心悄兮。",
      "source": "《诗经·陈风·月出》"
    },
    {
      "text": "门不夜关，道不拾遗。",
      "source": "《史记·七十列传·循吏列传》"
    },
    {
      "text": "不痴不聋，不作家翁。",
      "source": "《资治通鉴·唐纪四十》"
    },
    {
      "text": "新月恨其易沉，缺月恨其迟上。",
      "source": "《幽梦影》"
    },
    {
      "text": "鳞虫中金鱼，羽虫中紫燕，可云物类神仙。正如东方曼倩避世金马门，人不得而害之。",
      "source": "《幽梦影》"
    },
    {
      "text": "宁为鸡口，无为牛後。",
      "source": "《史记·七十列传·苏秦列传》"
    },
    {
      "text": "人无远虑，必有近忧。",
      "source": "《论语·卫灵公》"
    },
    {
      "text": "军中无戏言",
      "source": "《三国演义·第二十五回》"
    },
    {
      "text": "不耻不若人，何若人有？",
      "source": "《孟子·尽心章句上·第七节》"
    },
    {
      "text": "君子不怨天，不尤人。",
      "source": "《孟子·公孙丑章句下·第十三节》"
    },
    {
      "text": "良禽择木而栖，贤臣择主而事。",
      "source": "《三国演义·第三回》"
    },
    {
      "text": "民人以食为天。",
      "source": "《史记·七十列传·郦生陆贾列传》"
    },
    {
      "text": "食人之食者死人之事，吾岂可以乡利倍义乎！",
      "source": "《史记·七十列传·淮阴侯列传》"
    },
    {
      "text": "太平本是将军定，不许将军见太平。",
      "source": "《水浒传·第一百一十四回》"
    },
    {
      "text": "成人不自在，自在不成人。",
      "source": "《红楼梦·第八十二回》"
    },
    {
      "text": "目不能自见，鼻不能自嗅，舌不能自舐，手不能自握，惟耳能自闻其声。",
      "source": "《幽梦影》"
    },
    {
      "text": "不因俊俏难为友，正为风流始读书。",
      "source": "《红楼梦·第七回》"
    },
    {
      "text": "我所居兮，青埂之峰。我所游兮，鸿蒙太空。谁与我游兮？吾谁与从。",
      "source": "《红楼梦·第一百二十回》"
    },
    {
      "text": "靡不有初，鲜克有终。",
      "source": "《诗经·荡之什·荡》"
    },
    {
      "text": "人不知而不愠，不亦君子乎？",
      "source": "《论语·学而》"
    },
    {
      "text": "町畽鹿场，熠耀宵行。不可畏也，伊可怀也。",
      "source": "《诗经·豳风·东山》"
    },
    {
      "text": "有缘千里来相会，无缘对面不相逢。",
      "source": "《水浒传·第十四回》"
    },
    {
      "text": "吾与富贵而诎於人，宁贫贱而轻世肆志焉。",
      "source": "《史记·七十列传·鲁仲连邹阳列传》"
    },
    {
      "text": "天下之本在国，国之本在家，家之本在身。",
      "source": "《孟子·离娄章句上·第五节》"
    },
    {
      "text": "大丈夫生于乱世，当带三尺剑立不世之功；今所志未遂，奈何死乎！",
      "source": "《三国演义·第五十三回》"
    },
    {
      "text": "断送落花三月雨，摧残杨柳九秋霜。",
      "source": "《水浒传·第十六回》"
    },
    {
      "text": "恭者不侮人，俭者不夺人。",
      "source": "《孟子·离娄章句上·第十六节》"
    },
    {
      "text": "责其所难，则其易者不劳而正；补其所短，则其长者不劝而遂。",
      "source": "《资治通鉴·汉纪二十》"
    },
    {
      "text": "知恩不报，非为人也。",
      "source": "《水浒传·第二十回》"
    },
    {
      "text": "人众者胜天，天定亦能破人。",
      "source": "《史记·七十列传·伍子胥列传》"
    },
    {
      "text": "疾风知劲草，板荡识诚臣。",
      "source": "《资治通鉴·唐纪·唐纪十》"
    },
    {
      "text": "夫人必自侮，然后人侮之；家必自毁，而后人毁之；国必自伐，而后人伐之。",
      "source": "《孟子·离娄章句上·第八节》"
    },
    {
      "text": "春恨秋悲皆自惹，花容月貌为谁妍。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "为政以德，譬如北辰，居其所而众星共之。",
      "source": "《论语·为政》"
    },
    {
      "text": "永言配命，自求多福。",
      "source": "《诗经·文王之什·文王》"
    },
    {
      "text": "兵出无名，事故不成",
      "source": "《资治通鉴·汉纪·汉纪一》"
    },
    {
      "text": "以力服人者，非心服也，力不赡也；以德服人者，中心悦而诚服也",
      "source": "《孟子·公孙丑章句上·第三节》"
    },
    {
      "text": "知者不惑，仁者不忧，勇者不惧。",
      "source": "《论语·子罕》"
    },
    {
      "text": "赤日炎炎似火烧，野田禾稻半枯焦。",
      "source": "《水浒传·第十六回》"
    },
    {
      "text": "士不可以不弘毅，任重而道远。",
      "source": "《论语·泰伯》"
    },
    {
      "text": "贵易交，富易妻",
      "source": "《资治通鉴·汉纪·汉纪三十二》"
    },
    {
      "text": "仁者如射，射者正己而后发。发而不中，不怨胜己者，反求诸己而已矣。",
      "source": "《孟子·公孙丑章句上·第七节》"
    },
    {
      "text": "劳心者治人，劳力者治于人",
      "source": "《孟子·滕文公章句上·第四节》"
    },
    {
      "text": "如欲平治天下，当今之世，舍我其谁也？",
      "source": "《孟子·公孙丑章句下·第十三节》"
    },
    {
      "text": "赳赳武夫，公侯干城。",
      "source": "《诗经·周南·兔罝》"
    },
    {
      "text": "父母在，不远游，游必有方。",
      "source": "《论语·里仁》"
    },
    {
      "text": "吾十有五而志于学，三十而立，四十而不惑。",
      "source": "《论语·为政》"
    },
    {
      "text": "木朽不雕，世衰难佐。",
      "source": "《资治通鉴·梁纪·梁纪二十一》"
    },
    {
      "text": "文死谏，武死战",
      "source": "《红楼梦·第三十六回》"
    },
    {
      "text": "琴瑟在御，莫不静好。",
      "source": "《诗经·郑风·女曰鸡鸣》"
    },
    {
      "text": "凤凰于飞，翙翙其羽，亦傅于天。",
      "source": "《诗经·生民之什·卷阿》"
    },
    {
      "text": "君子以义死难，视死如归",
      "source": "《史记·七十列传·范雎蔡泽列传》"
    },
    {
      "text": "富贵而劳悴，不若安闲之贫贱；贫贱而骄傲，不若谦恭之富贵。",
      "source": "《幽梦影》"
    },
    {
      "text": "马逢伯乐而嘶，人遇知己而死。",
      "source": "《三国演义·第六十回》"
    },
    {
      "text": "有朋自远方来，不亦乐乎？",
      "source": "《论语·学而》"
    },
    {
      "text": "益者三友，损者三友。",
      "source": "《论语·季氏》"
    },
    {
      "text": "一死一生，乃知交情。一贫一富，乃知交态。",
      "source": "《史记·七十列传·汲郑列传》"
    },
    {
      "text": "道之以政，齐之以刑，民免而无耻。道之以德，齐之以礼，有耻且格。",
      "source": "《史记·七十列传·酷吏列传》"
    },
    {
      "text": "将顺其美，匡救其恶，故上下能哙亲也",
      "source": "《史记·管晏列传》"
    },
    {
      "text": "玉可碎而不可改其白，竹可焚而不可毁其节",
      "source": "《三国演义·第七十六回》"
    },
    {
      "text": "他山之石，可以攻玉。",
      "source": "《诗经·鸿雁之什·鹤鸣》"
    },
    {
      "text": "学而时习之，不亦说乎？",
      "source": "《论语·学而》"
    },
    {
      "text": "天然一段风骚，全在眉梢；平生万种情思，悉堆眼角。",
      "source": "《红楼梦·第三回》"
    },
    {
      "text": "昔人云：若无花月美人，不愿生此世界。予益一语云：若无翰墨棋酒，不必定作人身。",
      "source": "《幽梦影》"
    },
    {
      "text": "贤而多财，则损其志；愚而多财，则益其过。",
      "source": "《资治通鉴·汉纪·汉纪十七》"
    },
    {
      "text": "躬耕吾所不能，学灌园而已矣；樵薪吾所不能，学薙草而已矣。",
      "source": "《幽梦影》"
    },
    {
      "text": "昭君以和亲而显，刘蕡以下第而传。可谓之不幸，不可谓之缺陷。",
      "source": "《幽梦影》"
    },
    {
      "text": "听其言也，观其眸子，人焉廋哉？",
      "source": "《孟子·离娄章句上·第十五节》"
    },
    {
      "text": "死生契阔，与子成说。执子之手，与子偕老。",
      "source": "《诗经·邶风·击鼓》"
    },
    {
      "text": "默而识之，学而不厌，诲人不倦。",
      "source": "《论语·述而》"
    },
    {
      "text": "独善其身尽日安，何须千古名不朽！",
      "source": "《三国演义·第三十七回》"
    },
    {
      "text": "人有不为也，而后可以有为。",
      "source": "《孟子·离娄章句下·第八节》"
    },
    {
      "text": "圣人之官人，犹匠之用木也，取其所长，弃其所短。",
      "source": "《资治通鉴·周纪一》"
    },
    {
      "text": "诗僧时复有之，若道士之能诗者，不啻空谷足音，何也？",
      "source": "《幽梦影》"
    },
    {
      "text": "逝者如斯夫，不舍昼夜。",
      "source": "《论语·子罕》"
    },
    {
      "text": "治世不一道，便国不法古。",
      "source": "《史记·七十列传·商君列传》"
    },
    {
      "text": "凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。",
      "source": "《诗经·邶风·凯风》"
    },
    {
      "text": "天下大势，分久必合，合久必分。",
      "source": "《三国演义·第一回》"
    },
    {
      "text": "善用兵者不以短击长，而以长击短。",
      "source": "《史记·淮阴侯列传》"
    },
    {
      "text": "前车覆，后车诫。",
      "source": "《资治通鉴·汉纪·汉纪六》"
    },
    {
      "text": "楷书须如文人，草书须如名将，行书介乎二者之间，如羊叔子缓带轻裘，正是佳处。",
      "source": "《幽梦影》"
    },
    {
      "text": "任凭弱水三千，我只取一瓢饮。",
      "source": "《红楼梦·第九十一回》"
    },
    {
      "text": "开到荼蘼花事了。",
      "source": "《红楼梦·第六十三回》"
    },
    {
      "text": "不愧于人，不畏于天。",
      "source": "《诗经·节南山之什·何人斯》"
    },
    {
      "text": "欲而不知，失其所以欲；有而不知足，失其所以有",
      "source": "《史记·七十列传·范雎蔡泽列传》"
    },
    {
      "text": "知我者，谓我心忧；不知我者，谓我何求。",
      "source": "《诗经·王风·黍离》"
    },
    {
      "text": "满纸荒唐言，一把辛酸泪！",
      "source": "《红楼梦·第一回》"
    },
    {
      "text": "宁教我负天下人，休教天下人负我。",
      "source": "《三国演义·第四回》"
    },
    {
      "text": "德不孤，必有邻。",
      "source": "《论语·里仁》"
    },
    {
      "text": "巧言令色，鲜矣仁！",
      "source": "《论语·学而》"
    },
    {
      "text": "少年人须有老成之识见，老成人须有少年之襟怀。",
      "source": "《幽梦影》"
    },
    {
      "text": "痿人不忘起，盲者不忘视",
      "source": "《史记·七十列传·韩信卢绾列传》"
    },
    {
      "text": "进退盈缩，与时变化，圣人之常道也。",
      "source": "《史记·七十列传·范雎蔡泽列传》"
    },
    {
      "text": "上有好者，下必有甚焉者矣。",
      "source": "《孟子·滕文公章句上·第二节》"
    },
    {
      "text": "民为贵，社稷次之，君为轻。",
      "source": "《孟子·尽心章句下·第十四节》"
    },
    {
      "text": "机关算尽太聪明，反算了卿卿性命。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "古之不传于今者，啸也，剑术也，弹棋也，打球也。",
      "source": "《幽梦影》"
    },
    {
      "text": "庄周梦为蝴蝶，庄周之幸也；蝴蝶梦为庄周，蝴蝶之不幸也。",
      "source": "《幽梦影》"
    },
    {
      "text": "登泰山而小天下。",
      "source": "《孟子·尽心章句上·第二十四节》"
    },
    {
      "text": "假作真时真亦假，无为有处有还无。",
      "source": "《红楼梦·第一回》"
    },
    {
      "text": "周郎妙计安天下，赔了夫人又折兵！",
      "source": "《三国演义·第五十五回》"
    },
    {
      "text": "陷之死地而后生，置之亡地而后存",
      "source": "《资治通鉴·汉纪·汉纪二》"
    },
    {
      "text": "不患人之不己知，患其不能也。",
      "source": "《论语·学而》"
    },
    {
      "text": "箭在弦上，不得不发",
      "source": "《三国演义·第三十二回》"
    },
    {
      "text": "为月忧云，为书忧蠹，为花忧风雨，为才子、佳人忧命薄，真是菩萨心肠。",
      "source": "《幽梦影》"
    },
    {
      "text": "兼听则明，偏信则暗。",
      "source": "《资治通鉴·唐纪八》"
    },
    {
      "text": "两姑之间难为妇",
      "source": "《资治通鉴·陈纪·陈纪四》"
    },
    {
      "text": "将受命之日则忘其家，临军约束则忘其亲，援枹鼓之急则忘其身。",
      "source": "《史记·七十列传·司马穰苴列传》"
    },
    {
      "text": "君疑臣则臣必死",
      "source": "《三国演义·第一百一十九回》"
    },
    {
      "text": "取之有度，用之有节，则常足。",
      "source": "《资治通鉴·唐纪·唐纪五十》"
    },
    {
      "text": "滴不尽相思血泪抛红豆，开不完春柳春花满画楼，睡不稳纱窗风雨黄昏后，忘不了新愁与旧愁",
      "source": "《红楼梦·第二十八回》"
    },
    {
      "text": "父慈子孝，夫信妻贞，家之福也。",
      "source": "《史记·七十列传·范雎蔡泽列传》"
    },
    {
      "text": "兄弟既翕，和乐且湛。",
      "source": "《诗经·鹿鸣之什·棠棣》"
    },
    {
      "text": "君子挟才以为善，小人挟才以为恶。",
      "source": "《资治通鉴·周纪·周纪一》"
    },
    {
      "text": "置将不善，壹败涂地",
      "source": "《史记·高祖本纪》"
    },
    {
      "text": "春雨如恩诏，夏雨如赦书，秋雨如挽歌。",
      "source": "《幽梦影》"
    },
    {
      "text": "子治世之能臣，乱世之奸雄也。",
      "source": "《三国演义·第一回》"
    },
    {
      "text": "焦首朝朝还暮暮，煎心日日复年年。",
      "source": "《红楼梦·第二十二回》"
    },
    {
      "text": "未见君子，忧心忡忡。既见君子，我心则降。",
      "source": "《诗经·召南·草虫》"
    },
    {
      "text": "人固未易知，知人亦未易也。",
      "source": "《史记·七十列传·范雎蔡泽列传》"
    },
    {
      "text": "执竞武王，无竞维烈。",
      "source": "《诗经·清庙之什·执竞》"
    },
    {
      "text": "重足而立，侧目而视矣！",
      "source": "《史记·汲郑列传》"
    },
    {
      "text": "农不出则乏其食，工不出则乏其事，商不出则三宝绝，虞不出则财匮少。",
      "source": "《史记·七十列传·货殖列传》"
    },
    {
      "text": "君子务本，本立而道生。",
      "source": "《论语·学而》"
    },
    {
      "text": "人不可以无耻。无耻之耻，无耻矣。",
      "source": "《孟子·尽心章句上·第六节》"
    },
    {
      "text": "目不能识字，其闷尤过于盲；手不能执管，其苦更甚于哑。",
      "source": "《幽梦影》"
    },
    {
      "text": "礼无不答。",
      "source": "《资治通鉴·汉纪·汉纪三十六》"
    },
    {
      "text": "溥天之下，莫非王土；率土之滨，莫非王臣。",
      "source": "《诗经·谷风之什·北山》"
    },
    {
      "text": "鸢飞戾天，鱼跃于渊。",
      "source": "《诗经·文王之什·旱麓》"
    },
    {
      "text": "无谋之辈，见利必喜",
      "source": "《三国演义·第十六回》"
    },
    {
      "text": "蛇无头而不行，鸟无翅而不飞。",
      "source": "《水浒传·第六十回》"
    },
    {
      "text": "万两黄金容易得，知心一个也难求",
      "source": "《红楼梦·第五十七回》"
    },
    {
      "text": "人无刚骨，安身不牢。",
      "source": "《水浒传·第二十四回》"
    },
    {
      "text": "古之人，得志，泽加于民；不得志，修身见于世。穷则独善其身，达则兼善天下。",
      "source": "《孟子·尽心章句上·第九节》"
    },
    {
      "text": "经目之事，犹恐未真；背后之言，岂能全信？",
      "source": "《水浒传·第二十六回》"
    },
    {
      "text": "纷纷世事无穷尽，天数茫茫不可逃。",
      "source": "《三国演义·第一百二十回》"
    },
    {
      "text": "黄金有疵，白玉有瑕。",
      "source": "《史记·七十列传·龟策列传》"
    },
    {
      "text": "敏而好学，不耻下问。",
      "source": "《论语·公冶长》"
    },
    {
      "text": "有不虞之誉，有求全之毁。",
      "source": "《孟子·离娄章句上·第二十一节》"
    },
    {
      "text": "诚者，天之道也；思诚者，人之道也。至诚而不动者，未之有也；不诚，未有能动者也。",
      "source": "《孟子·离娄章句上·第十二节》"
    },
    {
      "text": "维桑与梓，必恭敬止。",
      "source": "《诗经·节南山之什·小弁》"
    },
    {
      "text": "其进锐者，其退速。",
      "source": "《孟子·尽心章句上·第四十四节》"
    },
    {
      "text": "身后有馀忘缩手，眼前无路想回头。",
      "source": "《红楼梦·第二回》"
    },
    {
      "text": "己所不欲，勿施于人。",
      "source": "《论语·颜渊》"
    },
    {
      "text": "三人行，必有我师焉。",
      "source": "《论语·述而》"
    },
    {
      "text": "看破的，遁入空门；痴迷的，枉送了性命。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "淡泊以明志。宁静而致远。",
      "source": "《三国演义·第三十七回》"
    },
    {
      "text": "人而无信，不知其可也。",
      "source": "《论语·为政》"
    },
    {
      "text": "有志者事竟成",
      "source": "《资治通鉴·汉纪·汉纪三十三》"
    },
    {
      "text": "兵家胜败真常事，卷甲重来未可知。",
      "source": "《三国演义·第十二回》"
    },
    {
      "text": "资之深，则取之左右逢其原",
      "source": "《孟子·离娄章句下·第十四节》"
    },
    {
      "text": "身未升腾思退步，功成应忆去时言。只因先主丁宁后，星落秋风五丈原。",
      "source": "《三国演义·第三十八回》"
    },
    {
      "text": "楼上看山，城头看雪，灯前看月，舟中看霞，月下看美人，另是一番情境。",
      "source": "《幽梦影》"
    },
    {
      "text": "本富为上，末富次之，奸富最下。",
      "source": "《史记·七十列传·货殖列传》"
    },
    {
      "text": "风雨如晦，鸡鸣不已。既见君子，云胡不喜？",
      "source": "《诗经·郑风·风雨》"
    },
    {
      "text": "一日不作，百日不食。",
      "source": "《史记·三十世家·赵世家》"
    },
    {
      "text": "无材可去补苍天，枉入红尘若许年。",
      "source": "《红楼梦·第一回》"
    },
    {
      "text": "欲速则不达，见小利则大事不成。",
      "source": "《论语·子路》"
    },
    {
      "text": "民亦劳止，汔可小康。",
      "source": "《诗经·生民之什·民劳》"
    },
    {
      "text": "养花胆瓶，其式之高低大小，须与花相称；而色之浅深浓淡，又须与花相反。",
      "source": "《幽梦影》"
    },
    {
      "text": "故音乐者，所以动荡血脉，通流精神而和正心也。",
      "source": "《史记·乐书》"
    },
    {
      "text": "一岁诸节，以上元为第一，中秋次之，五日、九日又次之。",
      "source": "《幽梦影》"
    },
    {
      "text": "叹人间，美中不足今方信。纵然是齐眉举案，到底意难平。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "弓开如秋月行天，箭去似流星落地",
      "source": "《三国演义·第十六回》"
    },
    {
      "text": "狡兔死，良狗亨；高鸟尽，良弓藏；敌国破，谋臣亡。",
      "source": "《史记·七十列传·淮阴侯列传》"
    },
    {
      "text": "为浊富，不若为清贫；以忧生，不若以乐死。",
      "source": "《幽梦影》"
    },
    {
      "text": "治国之道，富民为始；富民之要，在於节俭。",
      "source": "《史记·七十列传·平津侯主父列传》"
    },
    {
      "text": "七月流火，九月授衣。",
      "source": "《诗经·豳风·七月》"
    },
    {
      "text": "食不语，寝不言。",
      "source": "《论语·乡党》"
    },
    {
      "text": "季文子三思而后行。",
      "source": "《论语·公冶长》"
    },
    {
      "text": "国有贤相良将，民之师表也。",
      "source": "《史记·七十列传·太史公自序》"
    },
    {
      "text": "工欲善其事，必先利其器。",
      "source": "《论语·卫灵公》"
    },
    {
      "text": "花不可以无蝶，山不可以无泉，石不可以无苔，水不可以无藻，乔木不可以无藤萝，人不可以无癖。",
      "source": "《幽梦影》"
    },
    {
      "text": "高语山林者，辄不喜谈市朝事。审若此，则当并废《史》、《汉》诸书而不读矣。盖诸书所载者，皆古之市朝也。",
      "source": "《幽梦影》"
    },
    {
      "text": "他时若遂凌云志，敢笑黄巢不丈夫。",
      "source": "《水浒传·第三十九回》"
    },
    {
      "text": "当为花中之萱草，毋为鸟中之杜鹃。",
      "source": "《幽梦影》"
    },
    {
      "text": "君子喻于义，小人喻于利。",
      "source": "《论语·里仁》"
    },
    {
      "text": "世情看冷暖，人面逐高低。",
      "source": "《水浒传·第三十七回》"
    },
    {
      "text": "一日不见，如三秋兮。",
      "source": "《诗经·王风·采葛》"
    },
    {
      "text": "故天将降大任于是人也，必先苦其心志，劳其筋骨，饿其体肤，空乏其身，行拂乱其所为",
      "source": "《孟子·告子章句下·第十五节》"
    },
    {
      "text": "知之为知之，不知为不知，是知也。",
      "source": "《论语·为政》"
    },
    {
      "text": "无为其所不为，无欲其所不欲，如此而已矣。",
      "source": "《孟子·尽心章句上·第十七节》"
    },
    {
      "text": "深谋远虑，行军用兵之道",
      "source": "《史记·三十世家·陈涉世家》"
    },
    {
      "text": "呦呦鹿鸣，食野之苹。我有嘉宾，鼓瑟吹笙。",
      "source": "《诗经·鹿鸣之什·鹿鸣》"
    },
    {
      "text": "水来土掩，兵到将迎。",
      "source": "《水浒传·第二十回》"
    },
    {
      "text": "其身正，不令而行；其身不正，虽令不从。",
      "source": "《论语·子路》"
    },
    {
      "text": "吴王好剑客，百姓多创瘢；楚王好细腰，宫中多饿死。",
      "source": "《资治通鉴·汉纪·汉纪三十八》"
    },
    {
      "text": "坐谈则理高，行之则事阙。",
      "source": "《资治通鉴·梁纪·梁纪二》"
    },
    {
      "text": "疑则勿任，任则勿疑。",
      "source": "《资治通鉴·晋纪·晋纪四十》"
    },
    {
      "text": "礼之用，和为贵。",
      "source": "《论语·学而》"
    },
    {
      "text": "贤者以其昭昭，使人昭昭；今以其昏昏，使人昭昭。",
      "source": "《孟子·尽心章句下·第二十节》"
    },
    {
      "text": "大人者，不失其赤子之心者也。",
      "source": "《孟子·离娄章句下·第十二节》"
    },
    {
      "text": "得之易，失之易。得之难，失之难。",
      "source": "《水浒传·第一百一十六回》"
    },
    {
      "text": "人皆作之。作之不止，乃成君子",
      "source": "《资治通鉴·秦纪·秦纪一》"
    },
    {
      "text": "见义不为，无勇也。",
      "source": "《论语·为政》"
    },
    {
      "text": "行一不义，杀一无罪，而得天下，仁者不为也。",
      "source": "《资治通鉴·周纪·周纪四》"
    },
    {
      "text": "如月之恒，如日之升。如南山之寿，不骞不崩。",
      "source": "《诗经·鹿鸣之什·天保》"
    },
    {
      "text": "窗内人于窗纸上作字，吾于窗外观之，极佳。",
      "source": "《幽梦影》"
    },
    {
      "text": "花开又被风吹落，月皎那堪云雾遮。",
      "source": "《水浒传·第一百一十二回》"
    },
    {
      "text": "贫不学俭，卑不学恭。",
      "source": "《资治通鉴·魏纪·魏纪一》"
    },
    {
      "text": "道不同，不相为谋。",
      "source": "《论语·卫灵公》"
    },
    {
      "text": "君子能勤小物，故无大患。",
      "source": "《资治通鉴·周纪·周纪一》"
    },
    {
      "text": "南有乔木，不可休思；汉有游女，不可求思。",
      "source": "《诗经·周南·汉广》"
    },
    {
      "text": "大名之下，难以久居",
      "source": "《史记·三十世家·越王勾践世家》"
    },
    {
      "text": "维此文王，小心翼翼。",
      "source": "《诗经·文王之什·大明》"
    },
    {
      "text": "见贤思齐焉，见不贤而内自省也。",
      "source": "《论语·里仁》"
    },
    {
      "text": "质胜文则野，文胜质则史。文质彬彬，然后君子。",
      "source": "《论语·雍也》"
    },
    {
      "text": "富贵多士，贫贱寡友",
      "source": "《史记·七十列传·孟尝君列传》"
    },
    {
      "text": "艺花可以邀蝶，累石可以邀云，栽松可以邀风，贮水可以邀萍，筑台可以邀月，种蕉可以邀雨，植柳可以邀蝉。",
      "source": "《幽梦影》"
    },
    {
      "text": "自暴者，不可与有言也；自弃者，不可与有为也。",
      "source": "《孟子·离娄章句上·第十节》"
    },
    {
      "text": "才子而富贵，定从福、慧双修得来。",
      "source": "《幽梦影》"
    },
    {
      "text": "巧笑倩兮，美目盼兮。",
      "source": "《诗经·卫风·硕人》"
    },
    {
      "text": "穷则独善其身，达则兼善天下。",
      "source": "《孟子·尽心章句上·第九节》"
    },
    {
      "text": "物之稚者，皆不可厌，惟驴独否。",
      "source": "《幽梦影》"
    },
    {
      "text": "闻名不如见面，见面胜似闻名。",
      "source": "《水浒传·第三回》"
    },
    {
      "text": "楚虽三户，亡秦必楚",
      "source": "《史记·十二本纪·项羽本纪》"
    },
    {
      "text": "急来抱佛脚，闲时不烧香。",
      "source": "《水浒传·第十七回》"
    },
    {
      "text": "于嗟鸠兮，无食桑葚！于嗟女兮，无与士耽！",
      "source": "《诗经·卫风·氓》"
    },
    {
      "text": "草木也知愁，韶华竟白头！",
      "source": "《红楼梦·第七十回》"
    },
    {
      "text": "高岸为谷，深谷为陵。",
      "source": "《诗经·节南山之什·十月之交》"
    },
    {
      "text": "大丈夫处世，当努力建功立业，著鞭在先。今若不取，为他人所取，悔之晚矣。",
      "source": "《三国演义·第六十回》"
    },
    {
      "text": "百里不贩樵，千里不贩籴。",
      "source": "《史记·七十列传·货殖列传》"
    },
    {
      "text": "始之易，终之难也。",
      "source": "《史记·七十列传·春申君列传》"
    },
    {
      "text": "赏花宜对佳人，醉月宜对韵人，映雪宜对高人。",
      "source": "《幽梦影》"
    },
    {
      "text": "对渊博友，如读异书；对风雅友，如读名人诗文；对谨饬友，如读圣贤经传；对滑稽友，如阅传奇小说。",
      "source": "《幽梦影》"
    },
    {
      "text": "高山仰止，景行行止。",
      "source": "《诗经·甫田之什·车舝》"
    },
    {
      "text": "恃德者昌，恃力者亡。",
      "source": "《史记·七十列传·商君列传》"
    },
    {
      "text": "民以食为天。",
      "source": "《资治通鉴·汉纪·汉纪二》"
    },
    {
      "text": "狡兔死，走狗烹；飞鸟尽，良弓藏；敌国破，谋臣亡。",
      "source": "《资治通鉴·汉纪三》"
    },
    {
      "text": "丈夫处世兮立功名；立功名兮慰平生。慰平生兮吾将醉；吾将醉兮发狂吟！",
      "source": "《三国演义·第四十五回》"
    },
    {
      "text": "狂夫之言，圣人择焉",
      "source": "《史记·七十列传·淮阴侯列传》"
    },
    {
      "text": "千人所指，无病而死",
      "source": "《资治通鉴·汉纪·汉纪二十七》"
    },
    {
      "text": "战战兢兢，如临深渊，如履薄冰。",
      "source": "《诗经·节南山之什·小旻》"
    },
    {
      "text": "不孝有三，无后为大。",
      "source": "《孟子·离娄章句上·第二十六节》"
    },
    {
      "text": "温故而知新，可以为师矣。",
      "source": "《论语·为政》"
    },
    {
      "text": "投我以桃，报之以李。",
      "source": "《诗经·荡之什·抑》"
    },
    {
      "text": "太高人愈妒，过洁世同嫌。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "出于其类，拔乎其萃",
      "source": "《孟子·公孙丑章句上·第二节》"
    },
    {
      "text": "饥不择食，寒不择衣，慌不择路，贫不择妻。",
      "source": "《水浒传·第三回》"
    },
    {
      "text": "夫英雄者，胸怀大志，腹有良谋，有包藏宇宙之机，吞吐天地之志者也。",
      "source": "《三国演义·第二十一回》"
    },
    {
      "text": "学而不思则罔，思而不学则殆。",
      "source": "《论语·为政》"
    },
    {
      "text": "不在其位，不谋其政。",
      "source": "《论语·泰伯》"
    },
    {
      "text": "何当一夕金风起，为我扫除天下热。",
      "source": "《水浒传·第十六回》"
    },
    {
      "text": "君子坦荡荡，小人长戚戚。",
      "source": "《论语·述而》"
    },
    {
      "text": "关关雎鸠，在河之洲。窈窕淑女，君子好逑。",
      "source": "《诗经·周南·关雎》"
    },
    {
      "text": "俊眼修眉，顾盼神飞，文彩精华，见之忘俗。",
      "source": "《红楼梦·第三回》"
    },
    {
      "text": "寻乐境，乃学仙；避苦趣，乃学佛。佛家所谓极乐世界者，盖谓众苦之所不到也。",
      "source": "《幽梦影》"
    },
    {
      "text": "钱塘江上潮信来，今日方知我是我。",
      "source": "《水浒传·第一百一十九回》"
    },
    {
      "text": "名不正，则言不顺；言不顺，则事不成。",
      "source": "《论语·子路》"
    },
    {
      "text": "非信无以使民，非民无以守国。",
      "source": "《资治通鉴·周纪·周纪二》"
    },
    {
      "text": "桃之夭夭，灼灼其华。之子于归，宜其室家。",
      "source": "《诗经·周南·桃夭》"
    },
    {
      "text": "尽信书，则不如无书。",
      "source": "《孟子·尽心章句下·第三节》"
    },
    {
      "text": "入世须学东方曼倩，出世须学佛印了元。",
      "source": "《幽梦影》"
    },
    {
      "text": "窗外日光弹指过，席间花影坐前移。",
      "source": "《水浒传·第二回》"
    },
    {
      "text": "读经宜冬，其神专也；读史宜夏，其时久也；读诸子宜秋，其致别也；读诸集宜春，其机物也。",
      "source": "《幽梦影》"
    },
    {
      "text": "世事洞明皆学问，人情练达即文章。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "智足以拒谏，言足以饰非",
      "source": "《史记·汲郑列传》"
    },
    {
      "text": "凡声皆宜远听，惟听琴则远近皆宜。",
      "source": "《幽梦影》"
    },
    {
      "text": "老吾老，以及人之老；幼吾幼，以及人之幼。",
      "source": "《孟子·梁惠王章句上·第八节》"
    },
    {
      "text": "蒹葭苍苍，白露为霜。所谓伊人，在水一方。",
      "source": "《诗经·秦风·蒹葭》"
    },
    {
      "text": "我善养吾浩然之气。",
      "source": "《孟子·公孙丑章句上·第二节》"
    },
    {
      "text": "朝闻道，夕死可矣。",
      "source": "《论语·里仁》"
    },
    {
      "text": "纵然生得好皮囊，腹内原来草莽。",
      "source": "《红楼梦·第三回》"
    },
    {
      "text": "言必信，行必果。",
      "source": "《论语·子路》"
    },
    {
      "text": "智者举事，因祸为福，转败为功。",
      "source": "《史记·七十列传·苏秦列传》"
    },
    {
      "text": "上元须酌豪友，端午须酌丽友，七夕须酌韵友，中秋须酌淡友，重九须酌逸友。",
      "source": "《幽梦影》"
    },
    {
      "text": "因雪想高士，因花想美人，因酒想侠客，因月想好友，因山水想得意诗文。",
      "source": "《幽梦影》"
    },
    {
      "text": "丈夫一言许人，千金不易。",
      "source": "《资治通鉴·唐纪二》"
    },
    {
      "text": "岁寒，然后知松柏之后凋也。",
      "source": "《论语·子罕》"
    },
    {
      "text": "救寒莫如重裘，止谤莫如自修。",
      "source": "《资治通鉴·魏纪五》"
    },
    {
      "text": "法之不行，自于贵戚。",
      "source": "《史记·秦本纪》"
    },
    {
      "text": "得道者多助，失道者寡助。",
      "source": "《孟子·公孙丑章句下·第一节》"
    },
    {
      "text": "冬之夜，夏之日。百岁之后，归于其室。",
      "source": "《诗经·唐风·葛生》"
    },
    {
      "text": "酒能成事，酒能败事",
      "source": "《水浒传·第四回》"
    },
    {
      "text": "值太平世，生湖山郡；官长廉静，家道优裕；娶妇贤淑，生子聪慧。人生如此，可云全福。",
      "source": "《幽梦影》"
    },
    {
      "text": "生于忧患而死于安乐",
      "source": "《孟子·告子章句下·第十五节》"
    },
    {
      "text": "恻隐之心，仁之端也；羞恶之心，义之端也；辞让之心，礼之端也；是非之心，智之端也。",
      "source": "《孟子·公孙丑章句上·第六节》"
    },
    {
      "text": "博学而笃志，切问而近思，仁在其中矣。",
      "source": "《论语·子张》"
    },
    {
      "text": "鹤鸣于九皋，声闻于天。",
      "source": "《诗经·鸿雁之什·鹤鸣》"
    },
    {
      "text": "行有不得者，皆反求诸己，其身正而天下归之。",
      "source": "《孟子·离娄章句上·第四节》"
    },
    {
      "text": "君子食无求饱，居无求安，敏于事而慎于言。",
      "source": "《论语·学而》"
    },
    {
      "text": "经传宜独坐读，史鉴宜与友共读。",
      "source": "《幽梦影》"
    },
    {
      "text": "乐极生悲，否极泰来。",
      "source": "《水浒传·第二十六回》"
    },
    {
      "text": "猛兽不如群狐",
      "source": "《资治通鉴·晋纪·晋纪四十》"
    },
    {
      "text": "采采卷耳，不盈顷筐。嗟我怀人，寘彼周行。",
      "source": "《诗经·周南·卷耳》"
    },
    {
      "text": "我心匪石，不可转也。我心匪席，不可卷也。",
      "source": "《诗经·邶风·柏舟》"
    },
    {
      "text": "知子莫若父",
      "source": "《资治通鉴·晋纪·晋纪二十六》"
    },
    {
      "text": "君子之泽五世而斩",
      "source": "《孟子·离娄章句下·第二十二节》"
    },
    {
      "text": "吾日三省吾身：为人谋而不忠乎？与朋友交而不信乎？传不习乎？",
      "source": "《论语·学而》"
    },
    {
      "text": "酒乱性，色迷人。",
      "source": "《水浒传·第四十五回》"
    },
    {
      "text": "心病终须心药治，解铃还是系铃人。",
      "source": "《红楼梦·第九十回》"
    },
    {
      "text": "家贫思良妻，国乱思良相。",
      "source": "《资治通鉴·周纪·周纪一》"
    },
    {
      "text": "不怕官，只怕管。",
      "source": "《水浒传·第二回》"
    },
    {
      "text": "养虎自遗患",
      "source": "《史记·十二本纪·项羽本纪》"
    },
    {
      "text": "雨之为物，能令昼短，能令夜长。",
      "source": "《幽梦影》"
    },
    {
      "text": "嘤其鸣矣，求其友声。",
      "source": "《诗经·鹿鸣之什·伐木》"
    },
    {
      "text": "《诗》三百，一言以蔽之，曰：思无邪。",
      "source": "《论语·为政》"
    },
    {
      "text": "权，然后知轻重；度，然后知长短。",
      "source": "《孟子·梁惠王章句上·第八节》"
    },
    {
      "text": "过犹不及。",
      "source": "《论语·先进》"
    },
    {
      "text": "皎皎白驹，在彼空谷。生刍一束，其人如玉。",
      "source": "《诗经·鸿雁之什·白驹》"
    },
    {
      "text": "万事不由人做主，一心难与命争衡。",
      "source": "《三国演义·第一百零三回》"
    },
    {
      "text": "安危在出令，存亡在所任",
      "source": "《史记·楚元王世家》"
    },
    {
      "text": "醉里乾坤大，壶中日月长",
      "source": "《水浒传·第二十九回》"
    },
    {
      "text": "以若所为，求若所欲，犹缘木而求鱼也。",
      "source": "《孟子·梁惠王章句上·第八节》"
    },
    {
      "text": "到头来，依旧是风尘肮脏违心愿。",
      "source": "《红楼梦·第五回》"
    },
    {
      "text": "春者，天之本怀；秋者，天之别调。",
      "source": "《幽梦影》"
    },
    {
      "text": "老吾老，以及人之老；幼吾幼，以及人之幼，天下可运如掌。",
      "source": "《资治通鉴·汉纪·汉纪四十二》"
    },
    {
      "text": "一壶浊酒喜相逢。古今多少事，都付笑谈中。",
      "source": "《三国演义·第一回》"
    },
    {
      "text": "从善如登，从恶如崩",
      "source": "《资治通鉴·魏纪·魏纪三》"
    },
    {
      "text": "白骨如山忘姓氏，无非公子与红妆。",
      "source": "《红楼梦·第八回》"
    },
    {
      "text": "闻鹅声，如在白门；闻橹声，如在三吴；闻滩声，如在浙江；闻羸马项下铃铎声，如在长安道上。",
      "source": "《幽梦影》"
    },
    {
      "text": "爱之不以道，适所以害之也。",
      "source": "《资治通鉴·晋纪十八》"
    },
    {
      "text": "人须求可入诗，物须求可入画。",
      "source": "《幽梦影》"
    },
    {
      "text": "周虽旧邦，其命维新。",
      "source": "《诗经·文王之什·文王》"
    },
    {
      "text": "爱人者人恒爱之，敬人者人恒敬之。",
      "source": "《孟子·离娄章句下·第二十八节》"
    },
    {
      "text": "十岁为神童，二十、三十为才子，四十、五十为名臣，六十为神仙，可谓全人矣。",
      "source": "《幽梦影》"
    },
    {
      "text": "鉴前世之兴衰，考当今之得失",
      "source": "《资治通鉴·后周纪五》"
    },
    {
      "text": "鉴於水者见面之容，鉴於人者知吉与凶",
      "source": "《史记·七十列传·范睢蔡泽列传》"
    },
    {
      "text": "昔我往矣，杨柳依依。今我来思，雨雪霏霏。",
      "source": "《诗经·鹿鸣之什·采薇》"
    },
    {
      "text": "天下器玩之类，其制日工，其价日贱，毋惑乎民之贫也。",
      "source": "《幽梦影》"
    },
    {
      "text": "大丈夫生居天地间，岂能郁郁久居人下！",
      "source": "《三国演义·第九回》"
    },
    {
      "text": "头醋不酽彻底薄。",
      "source": "《水浒传·第五十一回》"
    },
    {
      "text": "富贵不能淫，贫贱不能移，威武不能屈。",
      "source": "《孟子·滕文公章句下·第二节》"
    },
    {
      "text": "道在迩而求诸远，事在易而求之难。",
      "source": "《孟子·离娄章句上·第十一节》"
    },
    {
      "text": "溯洄从之，道阻且长。溯游从之，宛在水中央。",
      "source": "《诗经·秦风·蒹葭》"
    },
    {
      "text": "惟贤惟德，可以服人。",
      "source": "《资治通鉴·魏纪·魏纪二》"
    },
    {
      "text": "大丈夫相时而动",
      "source": "《红楼梦·第四回》"
    },
    {
      "text": "瞻彼淇奥，绿竹猗猗。有匪君子，如切如磋，如琢如磨。",
      "source": "《诗经·卫风·淇奥》"
    },
    {
      "text": "既明且哲，以保其身。",
      "source": "《诗经·荡之什·烝民》"
    },
    {
      "text": "青青子衿，悠悠我心。",
      "source": "《诗经·郑风·子衿》"
    },
    {
      "text": "鹪鹩尚存一枝，狡兔犹藏三窟，何况人乎？",
      "source": "《三国演义·第六十回》"
    },
    {
      "text": "投我以木瓜，报之以琼琚。匪报也，永以为好也！",
      "source": "《诗经·卫风·木瓜》"
    },
    {
      "text": "嘴甜心苦，两面三刀，上头一脸笑，脚下使绊子，明是一盆火，暗是一把刀",
      "source": "《红楼梦·第六十五回》"
    },
    {
      "text": "君子和而不同，小人同而不和。",
      "source": "《论语·子路》"
    },
    {
      "text": "不患人之不己知，患不知人也。",
      "source": "《论语·学而》"
    },
    {
      "text": "并头联句，交颈论文，宫中应制，历使属国，皆极人间乐事。",
      "source": "《幽梦影》"
    },
    {
      "text": "强中自有强中手，用诈还逢识诈人。",
      "source": "《三国演义·第十七回》"
    },
    {
      "text": "维鹊有巢，维鸠居之。之子于归，百两御之。",
      "source": "《诗经·召南·鹊巢》"
    },
    {
      "text": "穷不失义，达不离道。",
      "source": "《孟子·尽心章句上·第九节》"
    },
    {
      "text": "人之忌，在好为人师。",
      "source": "《孟子·离娄章句上·第二十三节》"
    },
    {
      "text": "城门失火，殃及池鱼。",
      "source": "《资治通鉴·梁纪·梁纪十六》"
    },
    {
      "text": "士别三日，即更刮目相待",
      "source": "《资治通鉴·汉纪·汉纪五十八》"
    },
    {
      "text": "不虚美，不隐恶",
      "source": "《资治通鉴·唐纪·唐纪十三》"
    },
    {
      "text": "君子成人之美，不成人之恶。",
      "source": "《论语·颜渊》"
    },
    {
      "text": "知之者不如好之者，好之者不如乐之者。",
      "source": "《论语·雍也》"
    },
    {
      "text": "既生瑜，何生亮！",
      "source": "《三国演义·第五十七回》"
    }
  ]
}
