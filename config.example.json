{
  "outputDir": "state",
  "keepLocalHistory": false,
  "newsFile": "config/news.json",
  "news": {
    "source": "中国新闻网",
    "feedUrl": "https://www.chinanews.com.cn/rss/scroll-news.xml"
  },
  "weatherFile": "",
  "providers": {
    "deepseek": {
      "enabled": false,
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "copilot": {
      "enabled": false,
      "cloudQuery": true,
      "ghExecutableEnv": "GH_CLI_PATH",
      "allowLocalCacheRead": false,
      "cacheFile": "~/.cache/copilot/copilot-user-cache.json"
    },
    "codex": {
      "enabled": false,
      "experimental": true,
      "executableEnv": "CODEX_CLI_PATH"
    },
    "mimo": {
      "enabled": false,
      "balanceFile": "",
      "staleAfterMinutes": 30
    }
  }
}
